# ============================================================
#  .env PRODUCTION — Smart Door Lock
#  VPS: 103.155.224.54   |   https://smartdoorlock.dongkol.com
# ------------------------------------------------------------
#  Baris yang WAJIB kamu lengkapi ditandai:  << ISI INI >>
#  Nilai rahasia lain (DB, MQTT, JWT, API key) biarkan
#  seperti yang sudah ada di .env sekarang — jangan ditimpa.
# ============================================================

NODE_ENV = PRODUCTION

# ---------- 1. Database (container Docker "smartdoorlock") ----------
DATABASE_URL = "postgresql://admin:<< ISI INI: password postgres >>@localhost:5432/doorlock_db?schema=public"

# ---------- 2. MQTT (broker sendiri di VPS, container smart-doorlock-mosquitto) ----------
MQTT_HOST = 103.155.224.54
MQTT_PORT = 1884
MQTT_USERNAME = smart-doorlock
MQTT_PASSWORD = << ISI INI: password user smart-doorlock >>

# MQTT TOPICS
TOPIC_CAM_FRAME_META = doorlock/+/camera/frame/meta
TOPIC_CAM_FRAME_BIN = doorlock/+/camera/frame
TOPIC_CAM_RESULT = doorlock/{device_id}/camera/result
TOPIC_AUTH = doorlock/+/auth
TOPIC_STATUS = doorlock/+/status
TOPIC_REGISTRATION = doorlock/+/registration

# ---------- 3. Seeding (dipakai prisma/seed.js) ----------
SEED_API_ID = "dev-seed-id-123"
SEED_API_KEY = << ISI INI: nilai yang sekarang dipakai >>

# ---------- 4. JWT ----------
SECRET = << ISI INI: nilai yang sekarang dipakai >>

# ---------- 5. EMAIL SMTP — GMAIL ----------
# Cara membuat App Password (bukan password Gmail biasa):
#   1) https://myaccount.google.com/security  -> aktifkan 2-Step Verification
#   2) https://myaccount.google.com/apppasswords -> buat "doorlock-vps"
#   3) salin 16 karakter, boleh dengan atau tanpa spasi
MAIL_SERVER = smtp.gmail.com
MAIL_PORT   = 587
MAIL_SECURE = false
MAIL_USER   = zulfaprawiranegara354@gmail.com
MAIL_SECRET = << ISI INI: App Password 16 karakter >>
MAIL_FROM   = zulfaprawiranegara354@gmail.com

# ---------- 6. Google Sign-In (OAuth 2.0 Client ID) ----------
GOOGLE_CLIENT_ID_DEV = 868898161854-jmka85t3o0l8s1mkg3mjosufcji61v8u.apps.googleusercontent.com
GOOGLE_CLIENT_ID_PROD = 708602187983-0c8ucqd7s80vv65jf5plga2lqp4r9tpd.apps.googleusercontent.com
# Kosongkan untuk mengizinkan semua akun Google; isi "pnj.ac.id" untuk membatasi
GOOGLE_ALLOWED_DOMAIN =
