<div class="table-action mt-3 d-flex justify-content-between align-items-center">
  <h3 class="fw-bolder text-neutral-2">Fingerprint</h3>
  <button class="btn bg-blue-3 text-white rounded-13" type="button" data-bs-toggle="collapse" data-bs-target="#fingerprint-enroll-form">Mulai Enroll</button>
</div>
<p class="text-muted mb-0">Daftar sidik jari pada perangkat dan ruangan.</p>

<form class="collapse credential-form bg-neutral-6 rounded-13 p-3 mb-3 mt-3" id="fingerprint-enroll-form">
  <h6 class="fw-bold text-blue-3">Enroll fingerprint dari website</h6>
  <div class="row g-2">
    <div class="col-md-6">
      <label class="form-label">Device ID</label>
      <input class="form-control" name="deviceId" value="main_esp32_01" required>
    </div>
    <div class="col-md-6">
      <label class="form-label">Pengguna</label>
      <select class="form-select fingerprint-user-select" name="targetUserId" required>
        <option value="">Memuat pengguna…</option>
      </select>
      <small class="text-muted">Pilih pengguna dari database; UUID dikirim otomatis.</small>
    </div>
  </div>
  <button class="btn bg-blue-3 text-white mt-3" type="submit">Kirim perintah enroll</button>
</form>

<button class="btn btn-outline-primary rounded-13 mb-3" type="button" data-bs-toggle="collapse" data-bs-target="#fingerprint-sync-form">Sinkronkan fingerprint lama</button>
<form class="collapse credential-form bg-neutral-6 rounded-13 p-3 mb-3" id="fingerprint-sync-form">
  <h6 class="fw-bold text-blue-3">Sinkronkan fingerprint yang sudah tersimpan di sensor</h6>
  <p class="text-muted small">Hanya membuat mapping di database. Template fingerprint pada sensor tidak diubah.</p>
  <div class="row g-2">
    <div class="col-md-4">
      <label class="form-label">Device ID</label>
      <input class="form-control" name="deviceId" value="main_esp32_01" required>
    </div>
    <div class="col-md-4">
      <label class="form-label">Pengguna</label>
      <select class="form-select fingerprint-user-select" name="targetUserId" required>
        <option value="">Memuat pengguna…</option>
      </select>
    </div>
    <div class="col-md-4">
      <label class="form-label">ID jari (2–127)</label>
      <input class="form-control" type="number" name="fingerId" min="2" max="127" required>
    </div>
  </div>
  <button class="btn btn-outline-primary mt-3" type="submit">Simpan mapping</button>
</form>

<div class="api-list mt-3">
  <div class="table-header d-flex justify-content-between bg-neutral-7 py-2 rounded-13 mb-3 px-3">
    <p class="table-data fw-bold text-center text-neutral-2">User</p>
    <p class="table-data fw-bold text-center text-neutral-2">Ruangan</p>
    <p class="table-data fw-bold text-center text-neutral-2">Device</p>
    <p class="table-data fw-bold text-center text-neutral-2">ID Jari</p>
    <p class="table-data fw-bold text-center text-neutral-2">Status</p>
    <p class="table-data fw-bold text-center text-neutral-2">Aksi</p>
  </div>
  <div class="table-content bg-neutral-7 rounded-13 shadow credential-list" id="fingerprint-list" data-list-endpoint="/api/v1/fingerprint/list" data-update-endpoint="/api/v1/fingerprint/update" data-delete-endpoint="/api/v1/fingerprint/delete">
    <p class="text-center text-muted py-4 mb-0">Memuat data fingerprint…</p>
  </div>
</div>