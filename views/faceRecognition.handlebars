<div class="table-action mt-3 d-flex justify-content-between align-items-center">
  <h3 class="fw-bolder text-neutral-2">Face Recognition</h3>
  <button class="btn bg-blue-3 text-white rounded-13" type="button" data-bs-toggle="collapse" data-bs-target="#face-registration-form">Mulai Enroll</button>
</div>
<p class="text-muted mb-0">Registrasi wajah melalui ESP32-CAM dan layanan MobileFaceNet.</p>

<form class="collapse credential-form bg-neutral-6 rounded-13 p-3 mb-3 mt-3" id="face-registration-form">
  <h6 class="fw-bold text-blue-3">Enroll wajah dari website</h6>
  <div class="row g-2">
    <div class="col-md-6">
      <label class="form-label">Device ID</label>
      <input class="form-control" id="face-device-id" name="deviceId" value="main_esp32_01" required>
    </div>
    <div class="col-md-6">
      <label class="form-label">Pengguna</label>
      <select class="form-select face-user-select" id="face-user-select" name="targetUserId" required>
        <option value="">Memuat pengguna…</option>
      </select>
      <small class="text-muted">Pilih pengguna dari database; UUID dikirim otomatis.</small>
    </div>
  </div>
  <button class="btn bg-blue-3 text-white mt-3" type="submit">Mulai enroll wajah</button>
</form>

<div class="row mt-4">
  <div class="col-12">
    <section class="bg-neutral-7 rounded-13 shadow p-4">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold text-blue-3 mb-0">Preview capture</h5>
        <button class="btn btn-sm btn-outline-primary" id="refresh-capture-btn">Refresh</button>
      </div>
      <div class="text-center" id="face-preview-container">
        <img id="face-preview-image" src="" alt="Face capture preview" style="max-width:100%;max-height:400px;display:none;border-radius:13px;">
        <span class="text-muted" id="face-preview-placeholder">Belum ada capture dari perangkat</span>
      </div>
      <p class="text-muted small mt-2 mb-0" id="face-preview-info"></p>
    </section>
  </div>
</div>